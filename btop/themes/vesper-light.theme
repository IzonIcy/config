# Vesper Light theme for btop
# Light counterpart of the Rich Vesper theme (zezic/rich-vesper palette)

# Colors should be in 6 or 2 character hexadecimal or single spaced rgb decimal: "#RRGGBB", "#BW" or "0-255 0-255 0-255".

# Main background, empty for terminal default, needs to be empty for transparent background
theme[main_bg]="#FAF9F4"

# Main text color
theme[main_fg]="#2A2825"

# Title color for boxes
theme[title]="#96601E"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#0F7A4A"

# Background color of selected item in processes box
theme[selected_bg]="#EAE6DC"

# Foreground color of selected item in processes box
theme[selected_fg]="#141312"

# Color of inactive/disabled text
theme[inactive_fg]="#A8A29A"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#6B665E"

# Background color of the percentage meters
theme[meter_bg]="#E3DED3"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#7A5AA8"

# Cpu box outline color
theme[cpu_box]="#B8772A"

# Memory/disks box outline color
theme[mem_box]="#12803D"

# Net up/down box outline color
theme[net_box]="#3D6FB4"

# Processes box outline color
theme[proc_box]="#7A5AA8"

# Box divider line and small boxes line color
theme[div_line]="#D7D1C5"

# Temperature graph colors
theme[temp_start]="#C89A2E"
theme[temp_mid]="#D07B36"
theme[temp_end]="#B8433F"

# CPU graph colors
theme[cpu_start]="#6A9A3F"
theme[cpu_mid]="#C89A2E"
theme[cpu_end]="#C05838"

# Mem/Disk free meter
theme[free_start]="#D7D1C5"
theme[free_mid]="#B9C9A8"
theme[free_end]="#6A9A3F"

# Mem/Disk cached meter
theme[cached_start]="#A8C4D8"
theme[cached_mid]="#6F9BC7"
theme[cached_end]="#3D6FB4"

# Mem/Disk available meter
theme[available_start]="#E3D3A8"
theme[available_mid]="#C89A2E"
theme[available_end]="#96601E"

# Mem/Disk used meter
theme[used_start]="#6A9A3F"
theme[used_mid]="#C89A2E"
theme[used_end]="#C05838"

# Download graph colors
theme[download_start]="#A8C4D8"
theme[download_mid]="#6F9BC7"
theme[download_end]="#3D6FB4"

# Upload graph colors
theme[upload_start]="#D8B0C8"
theme[upload_mid]="#A97AB0"
theme[upload_end]="#7A5AA8"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#6A9A3F"
theme[process_mid]="#C89A2E"
theme[process_end]="#C05838"

# Process box banner colors
theme[proc_pause_bg]="#B8433F"
theme[proc_follow_bg]="#3D6FB4"
theme[proc_banner_bg]="#7A5AA8"
theme[proc_banner_fg]="#FFFFFF"

# Process following attributes
theme[followed_bg]="#3D6FB4"
theme[followed_fg]="#FFFFFF"
