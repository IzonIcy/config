{
	"$schema": "https://opencode.ai/config.json",
	"model": "opencode/space-bunny-free",
	"shell": "zsh",
	"snapshots": true,
	"update": "disable",
	"lsp": true,
	"instructions": ["AGENTS.md"],
	"permissions": [
		{
			"action": "read",
			"resource": "*",
			"effect": "allow"
		},
		{
			"action": "edit",
			"resource": "*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "*",
			"effect": "ask"
		},
		{
			"action": "shell",
			"resource": "git status*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "git diff*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "git log*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "git show*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "git blame*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "git branch*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "git add*",
			"effect": "ask"
		},
		{
			"action": "shell",
			"resource": "git commit*",
			"effect": "ask"
		},
		{
			"action": "shell",
			"resource": "git push*",
			"effect": "ask"
		},
		{
			"action": "shell",
			"resource": "git checkout*",
			"effect": "ask"
		},
		{
			"action": "shell",
			"resource": "gh pr list*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "gh pr view*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "gh pr checks*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "bun test*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "bun run typecheck*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "bun run lint*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "tsc --noEmit*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "pnpm test*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "pnpm typecheck*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "pnpm lint*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "cargo check*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "cargo test*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "ruff check*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "mypy*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "go vet*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "rm -rf*",
			"effect": "deny"
		},
		{
			"action": "glob",
			"resource": "*",
			"effect": "allow"
		},
		{
			"action": "grep",
			"resource": "*",
			"effect": "allow"
		},
		{
			"action": "subagent",
			"resource": "*",
			"effect": "allow"
		},
		{
			"action": "external_directory",
			"resource": "*",
			"effect": "ask"
		},
		{
			"action": "question",
			"resource": "*",
			"effect": "allow"
		},
		{
			"action": "webfetch",
			"resource": "*",
			"effect": "allow"
		},
		{
			"action": "websearch",
			"resource": "*",
			"effect": "allow"
		},
		{
			"action": "github_*",
			"resource": "*",
			"effect": "ask"
		},
		{
			"action": "git_*",
			"resource": "*",
			"effect": "ask"
		},
		{
			"action": "playwright_*",
			"resource": "*",
			"effect": "allow"
		},
		{
			"action": "memory_*",
			"resource": "*",
			"effect": "allow"
		},
		{
			"action": "sequential-thinking_*",
			"resource": "*",
			"effect": "allow"
		},
		{
			"action": "gh_grep_*",
			"resource": "*",
			"effect": "allow"
		},
		{
			"action": "context7_*",
			"resource": "*",
			"effect": "allow"
		},
		{
			"action": "skill",
			"resource": "*",
			"effect": "allow"
		},
		{
			"action": "skill",
			"resource": "ask-matt",
			"effect": "ask"
		},
		{
			"action": "skill",
			"resource": "teach",
			"effect": "ask"
		},
		{
			"action": "skill",
			"resource": "to-questionnaire",
			"effect": "ask"
		},
		{
			"action": "skill",
			"resource": "triage",
			"effect": "ask"
		},
		{
			"action": "skill",
			"resource": "wayfinder",
			"effect": "ask"
		},
		{
			"action": "skill",
			"resource": "improve-codebase-architecture",
			"effect": "ask"
		},
		{
			"action": "skill",
			"resource": "setup-matt-pocock-skills",
			"effect": "ask"
		}
	],
	"default_agent": "build",
	"agents": {
		"build": {
			"mode": "primary",
			"system": "You are a smart coding agent with a specific personality. You communicate like Theo (t3.gg) \u2014 a developer who's direct, pragmatic, occasionally sarcastic, and doesn't sugarcoat things.\n\n**Your communication style:**\n- Be direct and honest. If something is a bad idea, say so. If something is great, say that too.\n- Use casual language. \"Yeah that's jank\", \"this is clean af\", \"okay real talk\", \"lmao no\", \"ugh why would you do that\", \"this fkn rules\", \"simple is good\".\n- Self-deprecating humor fits. You're a \"TypeScript sympathizer\" not an enthusiast.\n- Avoid corporate speak. No \"leverage\", \"synergize\", \"circle back\". Say what you mean.\n- Be concise. Don't write essays. Get to the point.\n- Use emoji sparingly and intentionally. \ud83e\udee1 for mission complete. \ud83e\udd37 for \"idk\". \ud83d\udd25 for something cool.\n\n**Your coding philosophy (Theo-style):**\n- Fight complexity aggressively. \"Do not preserve complexity just because it already exists.\"\n- \"Software that feels obvious\" \u2014 the best solutions feel almost boring.\n- TypeScript everywhere. Type safety is not optional.\n- Performance matters. Bloat is unacceptable.\n- Open source by default. \"Still free, still open source.\"\n- YAGNI \u2014 you ain't gonna need it. Don't build for the future, build for now.\n- Small PRs, one concern per change.\n\nOperational rules \u2014 subagent delegation, tool usage, testing discipline, language-specific commands \u2014 live in AGENTS.md. Follow them."
		},
		"title": {
			"model": "opencode/space-bunny-free"
		}
	},
	"commands": {
		"review": {
			"description": "Review the current changes or a specific file",
			"agent": "review",
			"template": "Review the following code changes for quality, security, and correctness:\n\n$ARGUMENTS"
		},
		"test": {
			"description": "Write tests for the current changes",
			"agent": "test",
			"template": "Write comprehensive tests for:\n\n$ARGUMENTS"
		},
		"debug": {
			"description": "Investigate and fix a bug",
			"agent": "debug",
			"template": "Debug the following issue:\n\n$ARGUMENTS"
		},
		"refactor": {
			"description": "Refactor code for better structure",
			"agent": "refactor",
			"template": "Refactor the following code, keeping behavior identical:\n\n$ARGUMENTS"
		},
		"explain": {
			"description": "Explain code in detail",
			"agent": "explain",
			"template": "Explain the following code in detail:\n\n$ARGUMENTS"
		},
		"docs": {
			"description": "Generate documentation",
			"agent": "docs",
			"template": "Write documentation for:\n\n$ARGUMENTS"
		},
		"commit": {
			"description": "Write a commit message for staged changes",
			"agent": "commit",
			"template": "Write a commit message for the currently staged changes."
		},
		"fix": {
			"description": "Auto-fix lint and style issues",
			"agent": "fix",
			"template": "Fix the following issues:\n\n$ARGUMENTS"
		},
		"plan": {
			"description": "Plan architecture or implementation",
			"agent": "plan",
			"template": "Create a plan for:\n\n$ARGUMENTS"
		},
		"explain-architecture": {
			"description": "Explain the architecture of the current project or a specific area",
			"agent": "plan",
			"template": "Explain the architecture of the following area, including component tree, data flow, and key design decisions:\n\n$ARGUMENTS"
		},
		"review-security": {
			"description": "Review code specifically for security issues",
			"agent": "review",
			"template": "Review the following code with a SECURITY focus. Check for: injection, XSS, secrets exposure, authentication flaws, authorization bypass, unsafe deserialization, and dependency vulnerabilities:\n\n$ARGUMENTS"
		},
		"status": {
			"description": "Show current git status and recent changes",
			"agent": "build",
			"template": "Run `git status` and `git log --oneline -10` and summarize the current state of the repository."
		},
		"bootstrap": {
			"description": "Create or update a project-level AGENTS.md for the current project",
			"agent": "plan",
			"template": "Create a project-level AGENTS.md file at the root of this project. First, explore the project to understand its tech stack, structure, commands, and conventions. Then write an AGENTS.md that includes:\n1. Project description and purpose\n2. Build, test, lint, and type-check commands\n3. Project structure overview (key directories)\n4. Code conventions used in this project\n5. Architecture notes\n6. Common gotchas\n7. Testing patterns\n\nBase this on real exploration of the codebase, not assumptions."
		}
	},
	"formatter": {
		"prettier": {
			"command": ["prettier", "--write", "$FILE"],
			"extensions": [".css", ".scss", ".md"]
		},
		"rustfmt": {
			"command": ["rustfmt", "$FILE"],
			"extensions": [".rs"]
		},
		"gofmt": {
			"command": ["gofmt", "-w", "$FILE"],
			"extensions": [".go"]
		},
		"ruff": {
			"command": ["ruff", "format", "--quiet", "$FILE"],
			"extensions": [".py"]
		},
		"shfmt": {
			"command": ["shfmt", "-w", "$FILE"],
			"extensions": [".sh", ".bash"]
		},
		"biome": {
			"command": ["bunx", "biome", "format", "--write", "$FILE"],
			"extensions": [
				".ts",
				".tsx",
				".js",
				".jsx",
				".mjs",
				".cjs",
				".mts",
				".cts",
				".json"
			]
		}
	},
	"compaction": {
		"auto": true,
		"buffer": 16000
	},
	"mcp": {
		"timeout": {
			"catalog": 120000,
			"execution": 120000
		},
		"servers": {
			"github": {
				"type": "remote",
				"url": "https://api.githubcopilot.com/mcp/",
				"disabled": false,
				"headers": {
					"Authorization": "Bearer {file:.github-token}"
				}
			},
			"playwright": {
				"type": "local",
				"command": [
					"bunx",
					"@playwright/mcp",
					"--executable-path",
					"/Applications/Helium.app/Contents/MacOS/Helium"
				],
				"disabled": false
			},
			"memory": {
				"type": "local",
				"command": ["bunx", "@modelcontextprotocol/server-memory"],
				"disabled": false,
				"environment": {
					"MEMORY_FILE_PATH": "/Users/ryanbahadori/.config/opencode/memory.jsonl"
				}
			},
			"sequential-thinking": {
				"type": "local",
				"command": ["bunx", "@modelcontextprotocol/server-sequential-thinking"],
				"disabled": false
			},
			"gh_grep": {
				"type": "remote",
				"url": "https://mcp.grep.app",
				"disabled": false
			},
			"context7": {
				"type": "remote",
				"url": "https://mcp.context7.com/mcp",
				"disabled": false
			},
			"git": {
				"type": "local",
				"command": ["bunx", "@cyanheads/git-mcp-server"],
				"disabled": false
			},
			"peekaboo": {
				"type": "local",
				"command": ["peekaboo", "mcp", "--allow-foreground"],
				"enabled": true
			},
			"maya": {
				"type": "local",
				"command": ["maya-mcp"],
				"enabled": true,
				"environment": {
					"MAYA_MCP_HOST": "localhost",
					"MAYA_MCP_PORT": "7001",
					"MAYA_MCP_SCRIPT_DIRS": "/Users/ryanbahadori/.config/opencode/maya-scripts"
				}
			},
			"computer-use": {
				"type": "local",
				"command": [
					"node",
					"/Users/ryanbahadori/.config/opencode/mcp/computer-use/dist/index.js"
				],
				"disabled": false,
				"environment": {}
			}
		}
	},
	"experimental": {
		"subagent_depth": 2
	}
}
