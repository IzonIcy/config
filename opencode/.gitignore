node_modules/
# Agent memory is local-only. The public export was discontinued on
# 2026-10-20 after it shipped personal data; do not re-add it. These hold
# tailnet names, IPs and account emails. Matches *.bak-<suffix> too, which the
# root *.bak rule does not cover.
memory.jsonl
memory.jsonl.bak-*
memory.public.jsonl
.redact.py
# v2 writes the background service's auth token here. Secret, never commit.
service.json
# GitHub PAT for the github MCP server, read via {file:}. Secrets belong in
# 600 files, not in a config that gets committed.
.github-token
