node_modules/
# Unredacted memory store and its backups. memory.public.jsonl is the
# redacted copy that IS committed; these hold tailnet names, IPs and
# account emails, so they stay local. Matches *.bak-<suffix> too, which the
# root *.bak rule does not cover.
memory.jsonl
memory.jsonl.bak-*
.redact.py
# v2 writes the background service's auth token here. Secret, never commit.
service.json
# GitHub PAT for the github MCP server, read via {file:}. Secrets belong in
# 600 files, not in a config that gets committed.
.github-token
