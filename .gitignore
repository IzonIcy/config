# macOS
.DS_Store

# Databases / app-generated state
*.db
*.db-shm
*.db-wal
*.sqlite*

# Secrets / machine-local auth
gh/hosts.yml
fish/fish_variables
fish/conf.d/secrets.fish
nvim/lua/config/secrets.lua
opencode/auth.json
.mcp.json
*.pem
*.p12
*.pfx

# Personal agent memory
opencode/memory.jsonl



# Logs & app session state
*.log
herdr/session.json

# Spicetify downloaded artifacts (marketplace installs)
spicetify/CustomApps/marketplace*

# Node
node_modules/

# Raycast (extensions/ is a 600MB+ installed-extension cache)
raycast/extensions/
raycast/ai/
# node-compile-cache/ is regenerated V8 bytecode on every Raycast launch
raycast/node-compile-cache/
# Raycast extension endpoints carry live bearer tokens — never commit them.
# Track aster-endpoint.example.json instead so the shape is documented.
raycast/config.json
raycast/*-endpoint.json
!raycast/*-endpoint.example.json

# Editor backups
*.bak

# Generated fish completions
fish/completions/

# Self-referential symlinks from bootstrap
fish/fish/
ghostty/ghostty/
git/git/
mise/mise/

# Prisma generated
prisma/

# OpenCode skills installed separately, except the curated skills tracked here
opencode/skills/*
!opencode/skills/bun-ts/
!opencode/skills/bun-ts/**
!opencode/skills/debugging-workflow/
!opencode/skills/debugging-workflow/**
!opencode/skills/nextjs-ts/
!opencode/skills/nextjs-ts/**
!opencode/skills/pr-workflow/
!opencode/skills/pr-workflow/**
!opencode/skills/python-ts/
!opencode/skills/python-ts/**
!opencode/skills/react-vite/
!opencode/skills/react-vite/**
!opencode/skills/refactoring-workflow/
!opencode/skills/refactoring-workflow/**
!opencode/skills/rust-dev/
!opencode/skills/rust-dev/**
!opencode/skills/testing-workflow/
!opencode/skills/testing-workflow/**

# generated by the vite-plus CLI, not dotfiles
vite-plus/

# Pre-v2 opencode snapshot, kept as a local rollback. 61MB of node_modules plus
# live Homebrew tap-trust state and atuin config that XDG_CONFIG_HOME points at.
opencode-v1/
