[core]
	excludesfile = ~/.gitignore_global
	editor = nvim
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	side-by-side = true
	line-numbers = true

[init]
	defaultBranch = main

[push]
	default = current
	autoSetupRemote = true

[pull]
	rebase = true

[rebase]
	autoStash = true

[alias]
	s = status -s
	l = log --oneline --graph --all
	a = add .
	c = commit -m
	co = checkout
	b = branch
	d = diff
	ds = diff --staged
	undo = reset HEAD~1 --mixed
	amend = commit --amend --no-edit
	lg = log --oneline --graph --all --decorate
	last = log -1 HEAD
	who = shortlog -s --
	unstage = restore --staged .
	discard = restore .
	fetchp = fetch --prune --all
	cleanup = !git fetch --prune --all && git branch --merged | grep -v \"\\*\" | xargs -r git branch -d
	hist = log --graph --pretty=format:'%C(auto)%h %C(blue)%ad%C(reset) %s %C(cyan)(%an)%C(reset)%C(auto)%d' --date=short

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
